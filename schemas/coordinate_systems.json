{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coordinate_systems.schema",
  "type": "array",
  "uniqueItems": true,
  "minItems": 1,
  "$defs": {
    "coordinateSystem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "axes": {
          "$ref": "axes.schema"
        }
      },
      "required": [
        "id",
        "axes"
      ],
      "additionalProperties": false
    }
  },
  "items": {
    "$ref": "#/$defs/coordinateSystem"
  }
}